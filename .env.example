# Copy to .env and set your own local credentials. Never commit .env.
DATABASE_URL=postgresql+psycopg://equipmentdesk:CHANGE_ME@localhost:5432/equipmentdesk
SECRET_KEY=CHANGE_ME
APP_STORAGE_ROOT=./data
PORT=8080

# Only used by the explicit create-demo-user and seed-demo-data CLI commands.
DEMO_USERNAME=demo
# Set a local password (8-128 characters) before running either CLI command.
DEMO_PASSWORD=
